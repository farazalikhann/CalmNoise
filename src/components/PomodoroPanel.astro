---
// Collapsed-by-default Focus Timer panel. Purely a UI layer over
// src/scripts/pomodoro.ts (pure timer logic) and src/scripts/chime.ts
// (synthesized chime) — wired up in src/scripts/pomodoro-ui.ts, which also
// ducks the mixer's output via the shared engine instance during breaks but
// never starts/stops any sounds itself.
import { RESET_ICON } from '../config/sounds';
---

<section class="mx-auto mt-6 max-w-[1600px] px-4 sm:px-6 lg:mt-8 lg:px-10" data-focus-hide>
  <div class="glass" id="pomodoro-panel" style="border-radius: 22px;">
    <button
      type="button"
      id="pomodoro-toggle"
      class="flex min-h-11 w-full items-center justify-between gap-3 p-4 lg:p-5"
      aria-expanded="false"
      aria-controls="pomodoro-body"
    >
      <span class="flex items-center gap-2.5">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0 text-text-muted lg:h-5 lg:w-5" aria-hidden="true">
          <circle cx="12" cy="13" r="8"></circle>
          <path d="M12 9v4l2.5 2.5M9 2h6" stroke-linecap="round"></path>
        </svg>
        <span class="text-sm font-medium tracking-wide text-text lg:text-base">Focus Timer</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-xs font-light tabular-nums text-text-faint lg:text-sm" id="pomodoro-summary">Off</span>
        <svg
          id="pomodoro-chevron"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          class="shrink-0 text-text-faint transition-transform duration-300"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </button>

    <div id="pomodoro-body" class="hidden border-t border-white/10 p-4 lg:p-6">
      <div class="flex flex-col items-center gap-1.5 text-center">
        <p class="text-xs font-light uppercase tracking-[0.16em] text-text-faint" id="pomodoro-phase-label">Focus</p>
        <p class="text-5xl font-extralight tabular-nums tracking-wide text-text lg:text-7xl" id="pomodoro-countdown">25:00</p>
        <div class="mt-1 flex items-center gap-1.5" id="pomodoro-dots" aria-hidden="true">
          <span class="h-1.5 w-1.5 rounded-full bg-white/20" data-dot></span>
          <span class="h-1.5 w-1.5 rounded-full bg-white/20" data-dot></span>
          <span class="h-1.5 w-1.5 rounded-full bg-white/20" data-dot></span>
          <span class="h-1.5 w-1.5 rounded-full bg-white/20" data-dot></span>
        </div>
        <p class="text-xs font-light text-text-faint" id="pomodoro-session-label">Session 1 of 4</p>
      </div>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
        <button
          type="button"
          id="pomodoro-start-pause"
          class="glass inline-flex min-h-11 items-center justify-center gap-2 px-6 py-2.5 text-sm font-light text-text transition-all duration-300 ease-out hover:text-text lg:px-8 lg:py-3 lg:text-base"
          style="border-radius: 999px;"
          aria-pressed="false"
        >
          <svg id="pomodoro-icon-start" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7L8 5Z"></path>
          </svg>
          <svg id="pomodoro-icon-pause" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" class="hidden">
            <path d="M7 5h4v14H7zM13 5h4v14h-4z"></path>
          </svg>
          <span id="pomodoro-start-pause-label">Start</span>
        </button>
        <button
          type="button"
          id="pomodoro-reset"
          class="glass inline-flex min-h-11 items-center justify-center gap-2 px-5 py-2.5 text-sm font-light text-text-faint transition-all duration-300 ease-out hover:text-text-muted lg:px-6 lg:py-3 lg:text-base"
          style="border-radius: 999px;"
          title="Reset the focus timer"
          aria-label="Reset the focus timer"
        >
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0 opacity-60" aria-hidden="true" set:html={RESET_ICON} />
          <span>Reset</span>
        </button>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-3 border-t border-white/10 pt-5 sm:grid-cols-3">
        <label class="flex flex-col gap-1.5 text-xs font-light text-text-faint">
          Focus (min)
          <input
            type="number"
            id="pomodoro-focus-input"
            min="1"
            max="180"
            value="25"
            inputmode="numeric"
            class="glass min-h-11 px-3 text-sm text-text"
            style="border-radius: 14px;"
            aria-label="Focus duration in minutes"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-xs font-light text-text-faint">
          Short break (min)
          <input
            type="number"
            id="pomodoro-short-input"
            min="1"
            max="180"
            value="5"
            inputmode="numeric"
            class="glass min-h-11 px-3 text-sm text-text"
            style="border-radius: 14px;"
            aria-label="Short break duration in minutes"
          />
        </label>
        <label class="flex flex-col gap-1.5 text-xs font-light text-text-faint">
          Long break (min)
          <input
            type="number"
            id="pomodoro-long-input"
            min="1"
            max="180"
            value="15"
            inputmode="numeric"
            class="glass min-h-11 px-3 text-sm text-text"
            style="border-radius: 14px;"
            aria-label="Long break duration in minutes"
          />
        </label>
      </div>
      <p class="mt-3 text-center text-[11px] font-light leading-snug text-text-faint">
        Sounds keep playing during breaks, just quieter — the mix isn't stopped.
      </p>
    </div>
  </div>
</section>

<script>
  import { initPomodoro } from '../scripts/pomodoro-ui';
  initPomodoro();
</script>
