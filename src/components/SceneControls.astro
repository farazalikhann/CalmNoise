---
// Floating, purely visual controls: the background-scene picker and the
// Focus Mode toggle. No audio code is touched by src/scripts/theme-controls.ts.
import { BACKGROUND_THEMES } from '../config/backgrounds';
import { BASE as base } from '../utils/base';
---

<div class="floating-controls fixed bottom-4 right-4 z-30 flex flex-col items-end gap-3 sm:bottom-6 sm:right-6">
  <div class="relative" data-focus-hide>
    <button
      type="button"
      id="scene-picker-toggle"
      class="glass flex h-11 w-11 items-center justify-center text-text-muted transition-all duration-300 ease-out hover:text-text"
      style="border-radius: 999px;"
      aria-haspopup="true"
      aria-expanded="false"
      aria-label="Choose background scene"
    >
      <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M4 6h16v12H4z" stroke-linejoin="round"></path>
        <path d="m4 16 5-5 3.5 3.5L17 9l3 3" stroke-linecap="round" stroke-linejoin="round"></path>
        <circle cx="9" cy="9.5" r="1.4"></circle>
      </svg>
    </button>

    <div
      id="scene-picker-panel"
      class="glass absolute bottom-full right-0 mb-3 hidden w-72 origin-bottom-right p-4"
      style="border-radius: 22px;"
      role="menu"
      aria-label="Background scenes"
    >
      <p class="mb-3 text-[11px] font-medium uppercase tracking-[0.14em] text-text-faint">Background scene</p>
      <div class="grid grid-cols-3 gap-3">
        {
          BACKGROUND_THEMES.map((theme) => (
            <button
              type="button"
              class="scene-swatch-btn group flex flex-col items-center gap-1.5 rounded-2xl p-1.5 transition-all duration-300 ease-out"
              data-theme-id={theme.id}
              data-active="false"
              role="menuitemradio"
              aria-checked="false"
              title={theme.name}
            >
              <span
                class={`scene-swatch scene-${theme.id}`}
                style={`--scene-image: url('${base}backgrounds/${theme.file}');`}
              />
              <span class="text-center text-[10px] font-light leading-tight text-text-muted transition-colors duration-300 group-hover:text-text">
                {theme.name}
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <button
    type="button"
    id="focus-toggle"
    class="glass flex h-11 w-11 items-center justify-center text-text-muted transition-all duration-300 ease-out hover:text-text"
    style="border-radius: 999px;"
    aria-pressed="false"
    aria-label="Enter focus mode"
  >
    <svg id="focus-icon-enter" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M4 9V5h4M20 9V5h-4M4 15v4h4M20 15v4h-4" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    <svg id="focus-icon-exit" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" class="hidden">
      <path d="M9 4H5v4M15 4h4v4M9 20H5v-4M15 20h4v-4" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>
</div>

<script>
  import { initThemeControls } from '../scripts/theme-controls';
  initThemeControls();
</script>
