---
import { SOUNDS, PRESETS, RESET_ICON, SHARE_ICON } from '../config/sounds';
import SoundCard from './SoundCard.astro';
---

<section id="mixer" class="py-8 lg:py-12" aria-label="Ambient sound mixer">
  <!-- Transport: master play/pause + master volume. Fixed to the bottom of
       the viewport on mobile (see #mixer-transport in global.css) so it's
       always reachable while scrolling. -->
  <div
    id="mixer-transport"
    class="glass flex items-center justify-between gap-3 p-3 lg:gap-6 lg:p-6"
  >
    <div class="flex min-w-0 items-center gap-3 lg:gap-5">
      <button
        type="button"
        id="master-toggle"
        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent text-bg shadow-lg shadow-accent/25 transition-all duration-300 ease-out hover:scale-105 hover:shadow-accent/40 active:scale-95 lg:h-16 lg:w-16"
        aria-pressed="false"
        aria-label="Play mix"
      >
        <svg id="master-icon-play" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" class="lg:h-7 lg:w-7">
          <path d="M8 5v14l11-7L8 5Z"></path>
        </svg>
        <svg id="master-icon-pause" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" class="hidden lg:h-7 lg:w-7">
          <path d="M7 5h4v14H7zM13 5h4v14h-4z"></path>
        </svg>
      </button>
      <div class="min-w-0">
        <p class="truncate text-sm font-medium tracking-wide text-text lg:text-lg" id="master-status">Paused</p>
        <p class="hidden text-xs font-light text-text-faint lg:block lg:text-sm" id="master-hint" data-focus-hide>Tap any sound below, or press play to resume your last mix.</p>
      </div>
    </div>

    <div class="flex min-w-[110px] flex-1 items-center gap-2 lg:w-72 lg:flex-none lg:gap-3">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" class="shrink-0 text-text-muted lg:h-5 lg:w-5">
        <path d="M4 9v6h4l5 4V5L8 9H4Z" stroke-linejoin="round"></path>
      </svg>
      <input type="range" min="0" max="100" value="80" id="master-volume" class="min-w-0 flex-1" aria-label="Master volume" />
    </div>
  </div>

  <!-- Presets -->
  <div class="mt-6 flex flex-wrap items-center gap-2 lg:mt-10 lg:gap-3" data-focus-hide>
    <div class="flex flex-wrap gap-2 lg:gap-3" role="group" aria-label="Presets">
      {
        PRESETS.map((preset) => (
          <button
            type="button"
            class="preset-btn glass inline-flex min-h-11 items-center justify-center gap-2 px-4 py-2 text-sm font-light text-text-muted transition-all duration-300 ease-out hover:text-text lg:px-5 lg:py-3 lg:text-base"
            style="border-radius: 999px;"
            data-preset-id={preset.id}
            data-active="false"
            title={preset.description}
          >
            <svg
              viewBox="0 0 24 24"
              width="15"
              height="15"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              class="shrink-0 opacity-70"
              aria-hidden="true"
              set:html={preset.icon}
            />
            <span>{preset.name}</span>
          </button>
        ))
      }
    </div>

    <button
      type="button"
      id="share-mix"
      class="glass inline-flex min-h-11 items-center justify-center gap-2 px-4 py-2 text-sm font-light text-text-faint transition-all duration-300 ease-out hover:text-text-muted lg:px-5 lg:py-3 lg:text-base"
      style="border-radius: 999px;"
      title="Copy a shareable link to this mix"
      aria-label="Copy a shareable link to this mix"
    >
      <svg
        viewBox="0 0 24 24"
        width="15"
        height="15"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        class="shrink-0 opacity-60"
        aria-hidden="true"
        set:html={SHARE_ICON}
      />
      <span>Share</span>
    </button>

    <button
      type="button"
      id="reset-mix"
      class="glass inline-flex min-h-11 items-center justify-center gap-2 px-4 py-2 text-sm font-light text-text-faint transition-all duration-300 ease-out hover:text-text-muted lg:px-5 lg:py-3 lg:text-base"
      style="border-radius: 999px;"
      title="Reset all sounds and volumes"
      aria-label="Reset all sounds and volumes"
    >
      <svg
        viewBox="0 0 24 24"
        width="15"
        height="15"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        class="shrink-0 opacity-60"
        aria-hidden="true"
        set:html={RESET_ICON}
      />
      <span>Reset</span>
    </button>
  </div>

  <div
    id="share-toast"
    class="glass pointer-events-none left-1/2 top-4 z-40 -translate-x-1/2 whitespace-nowrap px-4 py-2.5 text-sm font-light text-text opacity-0 transition-opacity duration-300 sm:top-6"
    style="border-radius: 999px; position: fixed; width: max-content; max-width: calc(100vw - 2rem);"
    role="status"
    aria-live="polite"
  >
    Link copied to clipboard
  </div>

  <!-- Sound grid -->
  <div class="mt-6 lg:mt-8" id="sound-grid" data-focus-hide>
    {SOUNDS.map((sound) => <SoundCard sound={sound} />)}
  </div>

  <!-- Sleep timer -->
  <div
    class="glass mt-8 flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between lg:mt-12 lg:p-5"
    data-focus-hide
  >
    <div class="flex items-center gap-2">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" class="text-text-muted">
        <circle cx="12" cy="13" r="8"></circle>
        <path d="M12 9v4l2.5 2.5M9 2h6" stroke-linecap="round"></path>
      </svg>
      <span class="text-sm font-medium tracking-wide text-text">Sleep timer</span>
      <span id="sleep-countdown" class="text-xs text-accent" hidden></span>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" class="sleep-btn glass inline-flex min-h-11 items-center justify-center px-3 py-1.5 text-xs font-light text-text-muted transition-all duration-300 ease-out hover:text-text" style="border-radius: 999px;" data-minutes="15">15 min</button>
      <button type="button" class="sleep-btn glass inline-flex min-h-11 items-center justify-center px-3 py-1.5 text-xs font-light text-text-muted transition-all duration-300 ease-out hover:text-text" style="border-radius: 999px;" data-minutes="30">30 min</button>
      <button type="button" class="sleep-btn glass inline-flex min-h-11 items-center justify-center px-3 py-1.5 text-xs font-light text-text-muted transition-all duration-300 ease-out hover:text-text" style="border-radius: 999px;" data-minutes="60">60 min</button>
      <div class="flex items-center gap-1.5">
        <input
          type="number"
          id="sleep-custom"
          min="1"
          max="480"
          placeholder="Custom"
          class="glass min-h-11 w-20 px-3 py-1.5 text-xs text-text placeholder:text-text-faint"
          style="border-radius: 999px;"
          aria-label="Custom sleep timer in minutes"
        />
        <button type="button" id="sleep-custom-start" class="glass inline-flex min-h-11 items-center justify-center px-3 py-1.5 text-xs font-light text-text-muted transition-all duration-300 ease-out hover:text-text" style="border-radius: 999px;">Set</button>
      </div>
      <button type="button" id="sleep-cancel" class="inline-flex min-h-11 items-center justify-center rounded-full px-3 py-1.5 text-xs font-light text-text-faint underline decoration-dotted transition-colors duration-300 hover:text-text" hidden>Cancel</button>
    </div>
  </div>
</section>

<script>
  import { initMixer } from '../scripts/mixer-ui';
  initMixer();
</script>
