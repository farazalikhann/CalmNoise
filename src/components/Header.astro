---
import { SITE } from '../config/site';
import { BASE as base } from '../utils/base';
---

<header class="header-bar sticky top-0 z-20">
  <div class="mx-auto flex max-w-[1600px] items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-10 lg:py-6">
    <a href={base} class="flex items-center gap-3 text-text">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent lg:h-12 lg:w-12" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" class="lg:h-6 lg:w-6">
          <path d="M2 13c2-3 4-3 6 0s4 3 6 0 4-3 6 0" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="text-lg font-medium tracking-wide lg:text-xl">{SITE.name}</span>
    </a>
    <nav aria-label="Primary" class="flex items-center gap-6 text-base font-light text-text-muted sm:gap-8 lg:text-lg">
      <a href={`${base}#mixer`} class="transition-colors duration-300 hover:text-text">Mixer</a>
      <a href={`${base}#faq`} class="hidden transition-colors duration-300 hover:text-text sm:inline">FAQ</a>
      <a href={`${base}about`} class="hidden transition-colors duration-300 hover:text-text sm:inline">About</a>
    </nav>
  </div>
</header>
